# 複製到 /etc/open4wd-signer/signer.env（擁有者 root、權限 0640、群組 open4wd-signer）後填入。
# 本檔只放設定，不放金鑰內容；金鑰另存 SIGNER_KEY_FILE 指向的檔案。
OPEN4WD_PROFILE=private-playtest
SIGNER_DATA_DIR=/var/lib/open4wd-signer
SIGNER_KEY_SOURCE=file
SIGNER_KEY_FILE=/etc/open4wd-signer/governance.key
# 逗號分隔、每個都要含 /p2p/<PeerId>；填入你的 bootstrap 節點。
SIGNER_BOOTSTRAP=
SIGNER_HEALTH_HOST=127.0.0.1
SIGNER_HEALTH_PORT=9475
SIGNER_LOG_LEVEL=info
# 不設 SIGNER_LISTEN：工具預設只外連、不監聽、不當中繼。
